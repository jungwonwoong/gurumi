<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:background="#121212" android:layout_height="match_parent" android:layout_width="match_parent" android:orientation="horizontal" android:padding="16dp" xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 왼쪽 영역: 왼손 엄지 조종부 -->
    <LinearLayout android:gravity="center"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:layout_width="0dp"
        android:orientation="vertical">

        <Button android:backgroundTint="#2E7D32"
            android:id="@+id/btnForward"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:text="전 진 ▲"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <Button android:backgroundTint="#C62828"
            android:id="@+id/btnBackward"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:text="후 진 ▼"
            android:textSize="26sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- 오른쪽 영역: 블루투스 연결 및 상태 표시 -->
    <LinearLayout android:gravity="center" android:layout_height="match_parent" android:layout_weight="2" android:layout_width="0dp" android:orientation="vertical" android:paddingStart="24dp">

        <Button android:backgroundTint="#1976D2" android:id="@+id/btnConnect" android:layout_height="56dp" android:layout_marginBottom="16dp" android:layout_width="wrap_content" android:text="🔍 구루미 찾기 (블루투스)" android:textSize="18sp" android:textStyle="bold"/>

        <TextView android:id="@+id/tvStatus" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:layout_width="wrap_content" android:text="상태: 연결되지 않음" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>

        <TextView android:id="@+id/tvPitch" android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="좌우 기울기: 0° (중립)" android:textColor="#00E676" android:textSize="22sp" android:textStyle="bold"/>

    </LinearLayout>

</LinearLayout>